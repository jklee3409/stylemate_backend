<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mycom.myapp.user.dao.UserDao">
    <select id="findUser" parameterType="string" resultType="com.mycom.myapp.user.dto.UserDto">
        select * from user where kakao_id = #{kakaoId}
    </select>

    <select id="existsUser" parameterType="string" resultType="boolean">
        select 1 from user where kakao_id = #{kakaoId}
    </select>

    <insert id="insertUser" parameterType="com.mycom.myapp.user.dto.UserDto">
        insert into user (kakao_id, nickname, gender, height, weight)
        values (#{kakaoId}, #{nickname}, #{gender}, #{height}, #{weight})
    </insert>
</mapper>